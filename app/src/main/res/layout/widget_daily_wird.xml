<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#063B2C"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إتقان • الورد القرآني اليومي"
        android:textColor="#D4AF37"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="﴿ أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا ﴾"
        android:textColor="#FAF6EE"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_wird_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="الختمة الجارية: ٢٠ صفحة يومياً • مواظبة ٧ أيام"
        android:textColor="#E2D5B5"
        android:textSize="12sp" />

</LinearLayout>
