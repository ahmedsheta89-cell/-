rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin privilege check for platform manager ahmed.sheta89@gmail.com
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmed.sheta89@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('role' in data) || (data.role is string && data.role in ['ADMIN', 'TEACHER', 'STUDENT'])) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for StudentProfile
    function isValidStudentProfile(data, userId) {
      return data.keys().hasAll(['studentId', 'userId']) &&
        data.keys().hasOnly(['studentId', 'userId', 'currentSurah', 'currentAyah', 'totalAyahsMemorized', 'overallRetentionRate', 'updatedAt']) &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        (!('currentSurah' in data) || (data.currentSurah is number && data.currentSurah >= 1 && data.currentSurah <= 114)) &&
        (!('currentAyah' in data) || (data.currentAyah is number && data.currentAyah >= 1 && data.currentAyah <= 286)) &&
        (!('totalAyahsMemorized' in data) || (data.totalAyahsMemorized is number && data.totalAyahsMemorized >= 0 && data.totalAyahsMemorized <= 6236)) &&
        (!('overallRetentionRate' in data) || (data.overallRetentionRate is number && data.overallRetentionRate >= 0 && data.overallRetentionRate <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for RecitationSession
    function isValidRecitationSession(data, userId) {
      return data.keys().hasAll(['sessionId', 'userId', 'surahNumber', 'ayahNumber', 'mode']) &&
        data.keys().hasOnly(['sessionId', 'userId', 'surahNumber', 'ayahNumber', 'mode', 'accuracyScore', 'tajweedScore', 'fluencyScore', 'hesitationCount', 'errorCount', 'timestamp']) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.surahNumber is number && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.ayahNumber is number && data.ayahNumber >= 1 && data.ayahNumber <= 286 &&
        data.mode in ['OPEN_MUSHAF', 'BLIND_TEST'] &&
        (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100)) &&
        (!('tajweedScore' in data) || (data.tajweedScore is number && data.tajweedScore >= 0 && data.tajweedScore <= 100)) &&
        (!('fluencyScore' in data) || (data.fluencyScore is number && data.fluencyScore >= 0 && data.fluencyScore <= 100)) &&
        (!('hesitationCount' in data) || (data.hesitationCount is number && data.hesitationCount >= 0 && data.hesitationCount <= 1000)) &&
        (!('errorCount' in data) || (data.errorCount is number && data.errorCount >= 0 && data.errorCount <= 1000)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    // Validation Blueprint for MasteryCertificate
    function isValidMasteryCertificate(data) {
      return data.keys().hasAll(['certificateId', 'userId', 'studentName', 'surahNumber', 'verificationHash']) &&
        data.keys().hasOnly(['certificateId', 'userId', 'studentName', 'surahNumber', 'surahName', 'accuracyScore', 'verificationHash', 'issuedAt']) &&
        data.certificateId is string && data.certificateId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.studentName is string && data.studentName.size() <= 100 &&
        data.surahNumber is number && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.verificationHash is string && data.verificationHash.size() <= 128 &&
        (!('surahName' in data) || (data.surahName is string && data.surahName.size() <= 100)) &&
        (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100)) &&
        (!('issuedAt' in data) || (data.issuedAt is string && data.issuedAt.size() <= 64));
    }

    // Match rules for Users and nested subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // Subcollection: Profiles
      match /profiles/{profileId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(profileId) && isValidStudentProfile(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(profileId) && isValidStudentProfile(incoming(), userId) && incoming().studentId == existing().studentId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Recitations
      match /recitations/{recitationId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(recitationId) && isValidRecitationSession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(recitationId) && isValidRecitationSession(incoming(), userId) && incoming().sessionId == existing().sessionId;
        allow delete: if isOwner(userId);
      }
    }

    // Publicly Verifiable Certificates
    match /certificates/{certificateId} {
      allow get: if true; // Publicly verifiable with certificateId
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()); // Own certificates or Admin
      allow create: if isSignedIn() && isValidId(certificateId) && isValidMasteryCertificate(incoming());
      allow update: if false; // Certificates are immutable once created
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Test connection document for app initialization check
    match /test/{docId} {
      allow get, list, read: if true;
      allow write: if false;
    }
  }
}
