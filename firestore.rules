rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRecordType(recordType) {
      return recordType is string &&
        (recordType == 'lesson_progress' ||
         recordType == 'fsrs_review' ||
         recordType == 'certificate' ||
         recordType == 'bookmark' ||
         recordType == 'error_report');
    }

    function isValidStudySyncRecord(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             isValidRecordType(data.recordType) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.referenceKey is string && data.referenceKey.size() >= 1 && data.referenceKey.size() <= 120 &&
             data.scoreOrCount is int && data.scoreOrCount >= 0 && data.scoreOrCount <= 100000 &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/study_records/{recordId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(recordId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       incoming().keys().hasAll(['userId', 'recordType', 'title', 'referenceKey', 'scoreOrCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'recordType', 'title', 'referenceKey', 'scoreOrCount', 'notes', 'createdAt', 'updatedAt']) &&
                       isValidStudySyncRecord(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       isValidStudySyncRecord(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['recordType', 'title', 'referenceKey', 'scoreOrCount', 'notes', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(recordId);
    }
  }
}
